{
    "name": "suenerds/laravel-mercure-broadcaster",
    "description": "Mercure broadcaster",
    "keywords": [
        "laravel",
        "mercure",
        "broadcaster",
        "events",
        "SSE",
        "Server Sent Events"
    ],
    "homepage": "https://github.com/suenerds/laravel-mercure-broadcaster",
    "license": "MIT",
    "authors": [
        {
            "name": "Thore Sünert",
            "email": "thore.suenert@suenert.de",
            "homepage": "https://github.com/thoresuenert"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/broadcasting": "~10.0|~11.0|^12.0|^13.0",
        "lcobucci/jwt": "^5.0",
        "symfony/mercure": "^0.8"
    },
    "require-dev": {
        "laravel/pint": "^1.31",
        "orchestra/testbench": "~8.0|~9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5",
        "symfony/process": "~6.0|~7.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Suenerds\\LaravelMercureBroadcaster\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suenerds\\LaravelMercureBroadcaster\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Suenerds\\LaravelMercureBroadcaster\\LaravelMercureBroadcasterServiceProvider"
            ]
        }
    }
}
